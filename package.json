{
  "name": "wifi-mapper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal Wi-Fi research CLI for Windows",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest --watch",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "globals": "^16.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "chalk": "^6.0.1"
  }
}
